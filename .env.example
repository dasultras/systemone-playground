# TypeSafe (gehostet, US). Nur Server-Code liest den Key, nie mit NEXT_PUBLIC_-Präfix.
TYPESAFE_API_KEY=
# Höchstens so viele TypeSafe-Läufe pro Tag (Standard 200).
TYPESAFE_DAILY_REQUESTS=200

# Ollama (lokal). Im Container: http://host.docker.internal:11434 (setzt compose.yml).
OLLAMA_BASE_URL=http://localhost:11434

# Vorlagen als JSON (Standard config/presets.default.json), z. B. examples/presets.example.json.
# PRESETS_FILE=examples/presets.example.json
