# TypeSafe (gehostet, US). Nur Server-Code liest den Key, nie mit NEXT_PUBLIC_-Präfix.
TYPESAFE_API_KEY=
# Höchstens so viele TypeSafe-Läufe pro Tag (Standard 200).
TYPESAFE_DAILY_REQUESTS=200

# Ollama (lokal). Im Container: http://host.docker.internal:11434 (setzt compose.yml). Leer schaltet Ollama ab.
OLLAMA_BASE_URL=http://localhost:11434

# vLLM (lokal, optional). Ohne Wert erscheinen keine vLLM-Modelle.
# VLLM_BASE_URL=http://localhost:8000

# Vorausgewähltes Modell mit Backend-Präfix (Standard: erstes Ollama-Modell mit Capability „decision“).
# DEFAULT_MODEL=ollama:elephant-1:9b-q4-ctx8k

# Vorlagen als JSON (Standard config/presets.default.json), z. B. examples/presets.example.json.
# PRESETS_FILE=examples/presets.example.json
