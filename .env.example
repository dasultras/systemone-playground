# TypeSafe (hosted, US). Only server code reads the key, never with the NEXT_PUBLIC_ prefix.
TYPESAFE_API_KEY=
# At most this many TypeSafe runs per day (default 200).
TYPESAFE_DAILY_REQUESTS=200

# Ollama (local). In the container: http://host.docker.internal:11434 (set by compose.yml). Empty disables Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Allow pulling known models (config/models.json) from the UI; downloads them to the host (uses disk space).
# ALLOW_PULL=1

# vLLM (local, optional). Without a value no vLLM models appear.
# VLLM_BASE_URL=http://localhost:8000

# Preselected model with backend prefix (default: first Ollama model with the "decision" capability).
# DEFAULT_MODEL=ollama:elephant-1:9b-q4-ctx8k

# Presets as JSON (default config/presets.default.json), e.g. examples/presets.example.json.
# PRESETS_FILE=examples/presets.example.json
